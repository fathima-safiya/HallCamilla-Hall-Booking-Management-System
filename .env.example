# Copy to .env and fill in from Firebase Console → Project settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated admin emails (get admin panel access)
VITE_ADMIN_EMAILS=admin@camilla.com

# Password for reviewer quick-login demo accounts (create matching users in Firebase Auth)
VITE_DEMO_PASSWORD=CamillaDemo123!

# EmailJS Configuration for Real Emails
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
